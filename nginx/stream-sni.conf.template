# SNI demux: ClientHello → Xray / MTProto (Fake-TLS). Reality/TLS not terminated here.
map $ssl_preread_server_name $demux_backend {
    include /opt/amnezia/awg/nginx/stream-sni.map;
    default 127.0.0.1:9;
}

server {
    listen 443;
    ssl_preread on;
    proxy_pass $demux_backend;
    proxy_connect_timeout 5s;
    proxy_timeout 1d;
}
