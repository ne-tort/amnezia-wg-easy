# WEBUI_PUBLIC_PREFIX set (e.g. /panel): secret UI+API path; SUB_PUBLIC_PREFIX for subscriptions.
# Root (__ROOT_BLOCK__): mirror stub when same port as panel, or stealth 444 when mirror is on a separate port.
# Never redirect / → prefix — the path is protection, not a public bookmark.
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${PANEL_HTTPS_REDIRECT_HOST}$request_uri;
    }
}
server {
    listen 8443 ssl;
    server_name ${PANEL_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${PANEL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PANEL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # listen is :8443 inside the container; never leak that port in redirects
    port_in_redirect off;
    absolute_redirect off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = ${WEBUI_PUBLIC_PREFIX} {
        return 302 https://${PANEL_HTTPS_REDIRECT_HOST}${WEBUI_PUBLIC_PREFIX}/;
    }

    # Variable proxy_pass drops a URI suffix — rewrite + proxy_pass without path.
    location ${WEBUI_PUBLIC_PREFIX}/api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-awg;
        rewrite ^${WEBUI_PUBLIC_PREFIX}/api/(.*)$ /api/$1 break;
        proxy_pass http://$panel_upstream:${PANEL_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${PANEL_HTTPS_PORT};
    }

    location ${WEBUI_PUBLIC_PREFIX}/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-awg;
        rewrite ^${WEBUI_PUBLIC_PREFIX}/(.*)$ /$1 break;
        proxy_pass http://$panel_upstream:${PANEL_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${PANEL_HTTPS_PORT};
    }

    location ${SUB_PUBLIC_PREFIX}/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-awg;
        # Full /sub/... URI must reach the app (no path on proxy_pass).
        proxy_pass http://$panel_upstream:${PANEL_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${PANEL_HTTPS_PORT};
    }

__ROOT_BLOCK__
}
