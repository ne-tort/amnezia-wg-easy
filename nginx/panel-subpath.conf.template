# WEBUI_PUBLIC_PREFIX set (e.g. /panel): root behaviour from __ROOT_BLOCK__; panel under prefix; /api on site root.
server {
    listen 80;
    server_name ${PANEL_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    server_name ${PANEL_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${PANEL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PANEL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-wg-easy;
        proxy_pass http://$panel_upstream:${PANEL_PORT}/api/;
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = ${WEBUI_PUBLIC_PREFIX} {
        return 302 ${WEBUI_PUBLIC_PREFIX}/;
    }

    location ${WEBUI_PUBLIC_PREFIX}/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-wg-easy;
        proxy_pass http://$panel_upstream:${PANEL_PORT}/;
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

__ROOT_BLOCK__
}
