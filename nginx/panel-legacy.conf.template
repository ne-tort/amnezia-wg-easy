# Legacy: entire site is the panel (no WEBUI_PUBLIC_PREFIX).
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${PANEL_HTTPS_REDIRECT_HOST}$request_uri;
    }
}
server {
    listen 8443 ssl;
    server_name ${PANEL_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${PANEL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PANEL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    port_in_redirect off;
    absolute_redirect off;
    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $panel_upstream amnezia-wg-easy;
        proxy_pass http://$panel_upstream:${PANEL_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        # $http_host keeps :PANEL_HTTPS_PORT; $host strips it → broken /sub QR links.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${PANEL_HTTPS_PORT};
    }
}
