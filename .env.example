# =============================================================================
# Template (original). Do not edit for runtime values.
# deploy.sh copies this to .env and substitutes placeholders there.
# To start from scratch: remove .env and run ./deploy.sh again.
# =============================================================================

# Endpoint host for client configs: IP or domain (e.g. vpn.example.com).
# For local testing default is localhost; deploy may override in "domain" mode.
WG_HOST=127.0.0.1

# First-run admin (created when panel has no users).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Session signing key (set in production so sessions survive restarts).
# SESSION_SECRET=your_random_secret
# Firewall backend: nftables (default) or firewalld. Requires nft/firewall-cmd in container.
# FIREWALL_BACKEND=nftables
# If set to 1, process exits when firewall apply fails at startup (default: non-fatal, log only).
# FIREWALL_FAIL_FAST=0
# SQLite DB path (default: WG_PATH/panel.db).
# DB_PATH=/opt/amnezia/awg/panel.db

# Ports — see README "Ports" for the three layers (host HTTPS / in-container Node / VPN UDP).
# In-container TCP port for the Node app (nginx proxy_pass only; not the browser URL).
# WEBUI_BIND_HOST=0.0.0.0
PORT=51821
# VPN (UDP). Host publishes this port; ListenPort in awg0.conf matches. Re-download client configs after change.
# install.sh picks a free port in 20000–50000 unless you set one.
WG_PORT=51820
# Preferred internal TCP listen for amnezia-xray (auto if unset / legacy 443).
# Leave unset or set a free port in 20000–50000; panel allocates when using demux.
XRAY_PORT=24443
# Client-facing TCP ports (default both 443 → nginx SNI demux).
# Distinct values → direct docker publish, no demux for that service.
XRAY_PUBLIC_PORT=443
MTPROTO_PUBLIC_PORT=443
# Host ports: 80→80; PANEL_HTTPS→8443; demux ports only via docker-compose.ports.yml (portPlan).
PANEL_HTTP_PORT=80
PANEL_HTTPS_PORT=10123

# VPN subnet: first address is gateway (default 10.8.0.x -> 10.8.0.1).
# WG_DEFAULT_ADDRESS=10.8.0.x
# DNS line in client configs when Amnezia DNS is enabled in the panel UI (toggle in header).
# Should be the VPN gateway (e.g. 10.8.0.1). Direct/public DNS for clients is WG_DIRECT_DNS.
WG_DEFAULT_DNS=10.8.0.1
# WG_DIRECT_DNS=8.8.8.8, 8.8.4.4

# HTTPS: nginx serves the panel.
# SSL_MODE=selfsigned — nginx self-signed (local / first boot).
# SSL_MODE=acme       — certs pre-installed by install.sh (acme.sh domain or IP shortlived) into volume.
# SSL_MODE=certbot    — docker certbot profile (FQDN + CERTBOT_EMAIL).
# Без SSL_MODE: IP/127.0.0.1 → self-signed; FQDN + CERTBOT_EMAIL → certbot.
# SSL_MODE=selfsigned
PANEL_DOMAIN=127.0.0.1
# CERTBOT_EMAIL=you@example.com

# Nginx: panel under WEBUI_PUBLIC_PREFIX; subscriptions under SUB_PUBLIC_PREFIX; root = reverse-proxy mirror.
NGINX_CONFIG_PROFILE=entry
WEBUI_PUBLIC_PREFIX=/panel
SUB_PUBLIC_PREFIX=/sub
NGINX_ROOT_BEHAVIOR=mirror
NGINX_MIRROR_HOST=www.gov.uk
# NGINX_LOCAL_URL=

# Optional
# UI language for default GET /api/lang (ru | en). Synced to DB on startup when set.
LANGUAGE=ru
# CHECK_UPDATE=false
