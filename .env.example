# =============================================================================
# Template (original). Do not edit for runtime values.
# deploy.sh copies this to .env and substitutes placeholders there.
# To start from scratch: remove .env and run ./deploy.sh again.
# =============================================================================

# Endpoint host for client configs: IP or domain (e.g. vpn.example.com). If unset or placeholder, deploy sets it to detected public IP.
# WG_HOST=YOUR_SERVER_IP

# First-run admin (created when panel has no users). If unset or placeholder, deploy sets admin + random password and prints it at the end.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# Session signing key (set in production so sessions survive restarts).
# SESSION_SECRET=your_random_secret
# Firewall backend: nftables (default) or firewalld. Requires nft/firewall-cmd in container.
# FIREWALL_BACKEND=nftables
# If set to 1, process exits when firewall apply fails at startup (default: non-fatal, log only).
# FIREWALL_FAIL_FAST=0
# SQLite DB path (default: WG_PATH/panel.db).
# DB_PATH=/opt/amnezia/awg/panel.db

# Ports. Change in .env and restart; re-download client configs so Endpoint uses new WG_PORT.
# Web UI (TCP). Bind: 127.0.0.1 (local only) or 0.0.0.0 (all interfaces).
# WEBUI_BIND_HOST=0.0.0.0
PORT=51821
# VPN (UDP). Some use 443 or 41194; ensure firewall allows this port.
WG_PORT=51820

# VPN subnet: first address is gateway (default 10.8.0.x -> 10.8.0.1). Amnezia DNS uses this for sync.
# WG_DEFAULT_ADDRESS=10.8.0.x
# DNS for client configs. Gateway = Amnezia DNS (dnsmasq -> Unbound). Deploy sets this if unset.
WG_DEFAULT_DNS=10.8.0.1
# Alternative: public DNS (e.g. Google). Comment WG_DEFAULT_DNS above and set:
# WG_DEFAULT_DNS=8.8.8.8, 8.8.4.4
# Disable in-container dnsmasq (Amnezia DNS): set to 0, false, no, off or disabled.
# AMNEZIA_DNS_ENABLE=0

# HTTPS (nginx + Let's Encrypt): panel domain and email for certificate.
# PANEL_DOMAIN=panel.ai-qwerty.ru
# CERTBOT_EMAIL=admin@example.com

# Optional
# LANGUAGE=en
# CHECK_UPDATE=false
