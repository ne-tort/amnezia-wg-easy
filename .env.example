# Public IP or hostname of the VPN server (used in client configs)
WG_HOST=YOUR_SERVER_IP_OR_HOSTNAME

# Password for web admin UI login
PASSWORD=YOUR_ADMIN_PASSWORD

# Ports (optional). Change both in .env and restart; re-download client configs so Endpoint uses new WG_PORT.
# Web UI (TCP). Bind host IP: 127.0.0.1 (localhost only) or 0.0.0.0 (all interfaces).
# WEBUI_BIND_HOST=127.0.0.1
PORT=51821
# VPN (UDP). Some use 443 (looks like HTTPS) or 41194; ensure firewall allows this port.
WG_PORT=51820

# DNS for client configs. Use Amnezia DNS (container): set WG_DEFAULT_DNS=10.8.0.1; dnsmasq in wg-easy forwards to amnezia-dns.
# Otherwise e.g. 8.8.8.8 (1.1.1.1 often blocked in Russia).
# WG_DEFAULT_DNS=8.8.8.8
# WG_DEFAULT_DNS=10.8.0.1

# Disable update check notification (optional)
CHECK_UPDATE=false
