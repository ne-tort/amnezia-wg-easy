# =============================================================================
# Template (original). Do not edit for runtime values.
# deploy.sh copies this to .env and substitutes placeholders there.
# To start from scratch: remove .env and run ./deploy.sh again.
# =============================================================================

# Endpoint host for client configs: IP or domain (e.g. vpn.example.com).
# For local testing default is localhost; deploy may override in "domain" mode.
WG_HOST=127.0.0.1

# First-run admin (created when panel has no users).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Session signing key (set in production so sessions survive restarts).
# SESSION_SECRET=your_random_secret
# Firewall backend: nftables (default) or firewalld. Requires nft/firewall-cmd in container.
# FIREWALL_BACKEND=nftables
# If set to 1, process exits when firewall apply fails at startup (default: non-fatal, log only).
# FIREWALL_FAIL_FAST=0
# SQLite DB path (default: WG_PATH/panel.db).
# DB_PATH=/opt/amnezia/awg/panel.db

# Ports — see README "Ports" for the three layers (host HTTPS / in-container Node / VPN UDP).
# In-container TCP port for the Node app (nginx proxy_pass only; not the browser URL).
# WEBUI_BIND_HOST=0.0.0.0
PORT=51821
# VPN (UDP). Host publishes this port; ListenPort in awg0.conf matches. Re-download client configs after change.
WG_PORT=51820
# Host ports published by nginx (inside container nginx still listens on 80/443; these map host->container).
PANEL_HTTP_PORT=80
PANEL_HTTPS_PORT=443

# VPN subnet: first address is gateway (default 10.8.0.x -> 10.8.0.1). Amnezia DNS uses this for sync.
# WG_DEFAULT_ADDRESS=10.8.0.x
# DNS for client configs. Gateway = Amnezia DNS (dnsmasq -> Unbound). Deploy sets this if unset.
WG_DEFAULT_DNS=10.8.0.1
# Alternative: public DNS (e.g. Google). Comment WG_DEFAULT_DNS above and set:
# WG_DEFAULT_DNS=8.8.8.8, 8.8.4.4
# Disable in-container dnsmasq (Amnezia DNS): set to 0, false, no, off or disabled.
# AMNEZIA_DNS_ENABLE=0

# HTTPS: nginx serves the panel. Self-signed cert is generated in-container (long-lived for local use).
# Local panel: PANEL_DOMAIN=127.0.0.1 or localhost — certbot container is not started.
# Public hostname: set PANEL_DOMAIN to your domain and CERTBOT_EMAIL — deploy.sh starts certbot (Let's Encrypt + renew).
PANEL_DOMAIN=127.0.0.1
# CERTBOT_EMAIL=you@example.com

# Optional
# UI language for default GET /api/lang (ru | en). Synced to DB on startup when set.
LANGUAGE=ru
# CHECK_UPDATE=false
