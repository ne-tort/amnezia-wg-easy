PASSWORD=em1EogOZIGMS1+5EbCRpjg==
# (Supports: en, ru, tr, no, pl, fr, de, ca, es)
LANGUAGE=en
# Web UI (TCP). Открыть в браузере: http://IP:8080
WEBUI_BIND_HOST=0.0.0.0
PORT=8080
WG_DEVICE=eth0
# VPN (UDP). Clients get Endpoint = WG_HOST:41194
WG_PORT=41194
# MTU 1280 helps mobile (fragmentation); leave empty to omit from client config
WG_MTU=1280
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=10.8.0.1
# IPv4-only often fixes "no internet on phone"; add ", ::/0" for IPv6 through tunnel
WG_ALLOWED_IPS=0.0.0.0/0
# Keepalive 25 helps mobile NAT; set 0 to disable
WG_PERSISTENT_KEEPALIVE=25
