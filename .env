# =============================================================================
# Template (original). Do not edit for runtime values.
# deploy.sh copies this to .env and substitutes placeholders there.
# To start from scratch: remove .env and run ./deploy.sh again.
# =============================================================================

# Public IP or hostname of the VPN server (used in client config Endpoint)
WG_HOST=5.144.179.113

# Password for web admin UI login
PASSWORD=wYvlraSuVzATHEITxKJ5Kg==

# Ports. Change in .env and restart; re-download client configs so Endpoint uses new WG_PORT.
# Web UI (TCP). Bind: 127.0.0.1 (local only) or 0.0.0.0 (all interfaces).
# WEBUI_BIND_HOST=0.0.0.0
PORT=8080
# VPN (UDP). Some use 443 or 41194; ensure firewall allows this port.
WG_PORT=443

# DNS for client configs. Amnezia DNS (container): WG_DEFAULT_DNS=10.8.0.1
# WG_DEFAULT_DNS=8.8.8.8
# WG_DEFAULT_DNS=10.8.0.1

# HTTPS (nginx + Let's Encrypt): panel domain and email for certificate.
PANEL_DOMAIN=panel.ai-qwerty.ru
CERTBOT_EMAIL=netort@internet.ru

# Optional
# LANGUAGE=en
# CHECK_UPDATE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=eJ9/ZCeuRnfWMJHAIU2sJg==
